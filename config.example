# Declarative KEY="value" assignments; no shell commands or expansions.
# Prefer MAC matching: tolerates node suffix changes after reconnect/profile change.
# Use two DIFFERENT paired Bluetooth addresses (bluetoothctl devices).
LEFT_MAC="AA:BB:CC:DD:EE:01"
RIGHT_MAC="AA:BB:CC:DD:EE:02"

# Alternatively remove the MAC assignment for that side and set an exact node.name:
# LEFT_DEVICE="bluez_output.AA_BB_CC_DD_EE_01.1"
# RIGHT_DEVICE="bluez_output.AA_BB_CC_DD_EE_02.1"
# MAC takes precedence when both identifiers are present.
VIRTUAL_SINK="split_lr"

# Native delay buffers based on reported stream latency, not acoustic measurements.
# If testing shows audible delay updates with your devices, try false and compare.
LATENCY_COMPENSATE="true"

# Select outputs on presence transitions only; respect manual default changes.
# No volume/mute writes and no moving individual application streams.
AUTO_DEFAULT="true"
# Recommended: explicitly choose your normal output (pactl list short sinks).
FALLBACK_SINK=""

# Events accelerate availability changes; this audit catches lost PipeWire links.
CHECK_INTERVAL=10
# Bounded retry after command, graph or server failure (no Bluetooth reconnection).
ACTION_RETRY_DELAY=5

# Optional diagnostics for the candidate native client; may log device identifiers.
# Apply only on its next explicit start. No acoustic measurement is performed.
NATIVE_DEBUG="false"
